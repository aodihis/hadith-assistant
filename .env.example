DATABASE_URL=postgres://postgres:postgres@localhost:5433/hadiths
DATABASE_MAX_CONNECTIONS=10

# Without this, EnvFilter shows ERROR only — warnings such as a degraded
# answer or a failed history compaction stay invisible.
RUST_LOG=info

HOST=127.0.0.1
PORT=3000

# The app is excluded from Docker Compose by default so `topcoat dev` can run
# it on the host — faster to iterate on than rebuilding a Docker image per
# change. Docker Compose reads COMPOSE_PROFILES from this file directly (no
# Makefile or script involved). Uncomment to build and run the app in Docker
# instead.
# COMPOSE_PROFILES=app

VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=http://localhost:6334
QDRANT_COLLECTION=hadith_vectors

# Minimum cosine score a match must reach to count as relevant. Measured
# against text-embedding-3-small, natural-language questions score about
# 0.40-0.55 and a hadith quoted back verbatim peaks near 0.66, so anything at
# or above 0.7 discards every result and the assistant declines every turn.
RETRIEVAL_MIN_SCORE=0.45

# OPEN_ROUTER_API_KEY is shared by both the embedding and chat-completion
# clients below — one key, one provider.
OPEN_ROUTER_API_KEY=

# Embedding provider is OpenAI-compatible and swappable via config alone —
# these two values point it at OpenRouter's embeddings endpoint instead of
# the https://api.openai.com/v1 default.
#
# Changing EMBEDDING_MODEL invalidates every stored vector: embeddings from
# different models are not comparable. Drop the Qdrant collection, re-embed,
# and re-measure RETRIEVAL_MIN_SCORE above, which was tuned for this model.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small

# Chat completion (answer generation) is also OpenAI-compatible. The default
# model is a low-cost (not free) OpenRouter model — see README for current
# pricing before relying on it in production.
CHAT_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=deepseek/deepseek-v4-flash

# Generation profile for answers. Both are clamped in code (temperature to
# 0.0-0.7, max tokens to 64-1200) and an out-of-range or unparseable value
# fails at startup rather than silently falling back — an operator should
# never believe a constraint is in force when it is not.
#
# Temperature is kept low on purpose: this is religious content, and the model
# is meant to summarise retrieved narrations rather than write freely.
CHAT_TEMPERATURE=0.3
CHAT_MAX_TOKENS=700

# History compaction. A recap is internal notes the reader never sees, so it
# can run on a cheaper model than the answer; leave CHAT_SUMMARY_MODEL unset and
# it follows CHAT_MODEL, so switching models moves both rather than leaving
# compaction on the old one.
#
# The profile is colder than the answer profile because a drifting summary is a
# correctness problem, not a style one — every later turn is conditioned on it.
CHAT_SUMMARY_MODEL=
CHAT_SUMMARY_TEMPERATURE=0.1
CHAT_SUMMARY_MAX_TOKENS=300

# Conversation memory. Nothing is stored server-side: the browser replays the
# history each turn, and the server hands back a compacted copy.
#
# Compaction fires once the history passes CHAT_HISTORY_MAX_TURNS and folds it
# back down to CHAT_HISTORY_KEEP_TURNS. Keeping roughly half is what stops the
# extra summariser call running on every turn — KEEP must be less than MAX or
# startup fails. CHAT_HISTORY_MAX_CHARS triggers the same compaction on size,
# so a few very long answers cannot slip past the turn count.
CHAT_HISTORY_MAX_TURNS=8
CHAT_HISTORY_KEEP_TURNS=4
CHAT_HISTORY_MAX_CHARS=6000

# Upper bound on a single question. Client-supplied input drives paid provider
# calls, so it is bounded rather than trusted.
CHAT_MAX_QUESTION_CHARS=1000

# Signs chat session tokens, which key rate limiting. Holds no user data, so
# leaving it unset only means tokens stop being honoured after a restart —
# users see "this chat expired, start a new one". Set it in production so
# sessions survive a deploy.
SESSION_SECRET=
