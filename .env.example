DATABASE_URL=postgres://postgres:postgres@localhost:5433/hadiths
DATABASE_MAX_CONNECTIONS=10

HOST=127.0.0.1
PORT=3000

# The app is excluded from Docker Compose by default so `topcoat dev` can run
# it on the host — faster to iterate on than rebuilding a Docker image per
# change. Docker Compose reads COMPOSE_PROFILES from this file directly (no
# Makefile or script involved). Uncomment to build and run the app in Docker
# instead.
# COMPOSE_PROFILES=app

VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=http://localhost:6334
QDRANT_COLLECTION=hadith_vectors

# Embedding provider is OpenAI-compatible and swappable via config alone —
# these three values point it at OpenRouter's embeddings endpoint instead of
# the https://api.openai.com/v1 default.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
